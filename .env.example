# Environment variables for ComplianceTwin 360
# Database: Can use SQLite (default for instant zero-dependency out-of-box run) or PostgreSQL
DATABASE_URL=sqlite:///./compliance360.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compliance360

SECRET_KEY=compliancetwin-secret-key-360-hackathon-2025-secure
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage: Local directory or MinIO S3 compatible
STORAGE_PROVIDER=local
STORAGE_DIR=./uploads

# Celery / Redis background worker fallback (Internal thread worker active if Redis offline)
REDIS_URL=redis://localhost:6379/0

